msgstr "W pełni uzgodnione"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Approve this cash payment? The approver must not be the requester."
msgstr "Zatwierdzić tę płatność gotówkową? Zatwierdzający nie może być wnioskodawcą."

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Queue for posting"
msgstr "Dodaj do kolejki księgowania"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Retry posting"
