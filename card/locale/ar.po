msgid "Item tax template {0} no longer matches the company's VAT accounts; re-run the posting master setup."
msgstr "قالب ضريبة الصنف {0} لم يعد مطابقاً لحسابات الضريبة للشركة؛ أعد تهيئة بيانات الترحيل."

msgid "Item tax template {0} must carry a flat {1}% rate."
