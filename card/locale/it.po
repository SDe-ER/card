#: card/cash_disbursement.py
msgid "A cash payment is already requested for row {0} of card {1}."
msgstr "Un pagamento in contanti per la riga {0} della carta {1} è già stato richiesto."

#: card/cash_disbursement.py
msgid "A cash payment is requested on a Draft card only."
msgstr "Un pagamento in contanti può essere richiesto solo per una carta in bozza."

#: card/cash_disbursement.py
msgid "Give the reason for the cancellation."
msgstr "Indicare il motivo dell'annullamento."

#: card/cash_disbursement.py
msgid "Only a cancelled cash payment can be replaced; {0} is {1}."
msgstr "Può essere sostituito solo un pagamento in contanti annullato; {0} è {1}."

#: card/cash_disbursement.py
msgid "Only a Card Manager can approve a cash payment."
msgstr "Solo un Responsabile carte può approvare un pagamento in contanti."

#: card/cash_disbursement.py
msgid "Only a Card Manager can post a cash payment."
msgstr "Solo un Responsabile carte può registrare un pagamento in contanti."

#: card/cash_disbursement.py
msgid "Only a Card Manager can request a cancellation."
msgstr "Solo un Responsabile carte può richiedere un annullamento."

#: card/cash_disbursement.py
msgid "Only a Card Manager can request a replacement."
msgstr "Solo un Responsabile carte può richiedere una sostituzione."

#: card/cash_disbursement.py
msgid "Only a Pending cash payment can be approved; {0} is {1}."
msgstr "Può essere approvato solo un pagamento in contanti in attesa; {0} è {1}."

#: card/cash_disbursement.py
msgid "Only a posted cash payment can be cancelled; {0} is {1}."
msgstr "Può essere annullato solo un pagamento in contanti registrato; {0} è {1}."

#: card/cash_disbursement.py
msgid "Only a queued cash payment can be executed; {0} is {1}."
msgstr "Può essere eseguito solo un pagamento in contanti in coda; {0} è {1}."

#: card/cash_disbursement.py
msgid "Only an approved cash payment can be queued for posting; {0} is {1}."
msgstr "Può essere messo in coda per la registrazione solo un pagamento in contanti approvato; {0} è {1}."

#: card/cash_disbursement.py
msgid "Row {0} of card {1} already has a live cash payment ({2})."
msgstr "La riga {0} della carta {1} ha già un pagamento in contanti attivo ({2})."

#: card/cash_disbursement.py
msgid "The cash payment {0} does not exist."
msgstr "Il pagamento in contanti {0} non esiste."

#: card/cash_disbursement.py
msgid "The cash payment {0} is {1}; it cannot be deleted. Cancel it instead."
msgstr "Il pagamento in contanti {0} è {1}; non può essere eliminato. Annullarlo invece."

#: card/cash_disbursement.py
msgid "The requester cannot approve their own cash payment."
msgstr "Il richiedente non può approvare il proprio pagamento in contanti."

#: card/cash_disbursement.py
msgid "The row {0} is no longer on card {1}."
msgstr "La riga {0} non è più sulla carta {1}."

#: card/cash_disbursement.py
msgid "The row {0} is not a cash payment on card {1}."
msgstr "La riga {0} non è un pagamento in contanti sulla carta {1}."

#: card/cash_disbursement.py
msgid "The cash payment {0} is approved; {1} cannot be changed. Cancel it and request a replacement."
msgstr "Il pagamento in contanti {0} è approvato; {1} non può essere modificato. Annullarlo e richiedere una sostituzione."

#: card/cash_disbursement.py
msgid "Journal entry {0} still has active allocations. Resolve them in ERPNext (unreconcile or unlink) before cancelling it."
msgstr "La registrazione contabile {0} ha ancora allocazioni attive. Risolverle in ERPNext (annullare la riconciliazione o scollegare) prima dell'annullamento."

#: card/cash_disbursement.py
msgid "Journal entry {0} pays cash payment {1}. Request its cancellation with a reason first; the payment is then marked Cancelled."
msgstr "La registrazione contabile {0} salda il pagamento in contanti {1}. Richiedere prima l'annullamento con un motivo; il pagamento sarà poi contrassegnato come Annullato."
