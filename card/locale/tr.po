#: card/cash_disbursement.py
msgid "A cash payment is already requested for row {0} of card {1}."
msgstr "{1} kartının {0}. satırı için nakit ödeme zaten talep edildi."

#: card/cash_disbursement.py
msgid "A cash payment is requested on a Draft card only."
msgstr "Nakit ödeme yalnızca taslak durumundaki bir kart için talep edilebilir."

#: card/cash_disbursement.py
msgid "Give the reason for the cancellation."
msgstr "İptal nedenini girin."

#: card/cash_disbursement.py
msgid "Only a cancelled cash payment can be replaced; {0} is {1}."
msgstr "Yalnızca iptal edilmiş bir nakit ödeme değiştirilebilir; {0} durumu: {1}."

#: card/cash_disbursement.py
msgid "Only a Card Manager can approve a cash payment."
msgstr "Nakit ödemeyi yalnızca bir Kart Yöneticisi onaylayabilir."

#: card/cash_disbursement.py
msgid "Only a Card Manager can post a cash payment."
msgstr "Nakit ödemeyi yalnızca bir Kart Yöneticisi kaydedebilir."

#: card/cash_disbursement.py
msgid "Only a Card Manager can request a cancellation."
msgstr "İptal talebini yalnızca bir Kart Yöneticisi oluşturabilir."

#: card/cash_disbursement.py
msgid "Only a Card Manager can request a replacement."
msgstr "Değişim talebini yalnızca bir Kart Yöneticisi oluşturabilir."

#: card/cash_disbursement.py
msgid "Only a Pending cash payment can be approved; {0} is {1}."
msgstr "Yalnızca bekleyen bir nakit ödeme onaylanabilir; {0} durumu: {1}."

#: card/cash_disbursement.py
msgid "Only a posted cash payment can be cancelled; {0} is {1}."
msgstr "Yalnızca kaydedilmiş bir nakit ödeme iptal edilebilir; {0} durumu: {1}."

#: card/cash_disbursement.py
msgid "Only a queued cash payment can be executed; {0} is {1}."
msgstr "Yalnızca kuyruktaki bir nakit ödeme çalıştırılabilir; {0} durumu: {1}."

#: card/cash_disbursement.py
msgid "Only an approved cash payment can be queued for posting; {0} is {1}."
msgstr "Yalnızca onaylanmış bir nakit ödeme kaydetme kuyruğuna alınabilir; {0} durumu: {1}."

#: card/cash_disbursement.py
msgid "Row {0} of card {1} already has a live cash payment ({2})."
msgstr "{1} kartının {0}. satırında zaten etkin bir nakit ödeme var ({2})."

#: card/cash_disbursement.py
msgid "The cash payment {0} does not exist."
msgstr "{0} nakit ödemesi mevcut değil."

#: card/cash_disbursement.py
msgid "The cash payment {0} is {1}; it cannot be deleted. Cancel it instead."
msgstr "{0} nakit ödemesinin durumu {1}; silinemez. Bunun yerine iptal edin."

#: card/cash_disbursement.py
msgid "The requester cannot approve their own cash payment."
msgstr "Talep eden kişi kendi nakit ödemesini onaylayamaz."

#: card/cash_disbursement.py
msgid "The row {0} is no longer on card {1}."
msgstr "{0} satırı artık {1} kartında yok."

#: card/cash_disbursement.py
msgid "The row {0} is not a cash payment on card {1}."
msgstr "{0} satırı {1} kartında bir nakit ödeme değil."

#: card/cash_disbursement.py
msgid "The cash payment {0} is approved; {1} cannot be changed. Cancel it and request a replacement."
msgstr "{0} nakit ödemesi onaylandı; {1} değiştirilemez. İptal edin ve değişim talep edin."

#: card/cash_disbursement.py
msgid "Journal entry {0} still has active allocations. Resolve them in ERPNext (unreconcile or unlink) before cancelling it."
msgstr "{0} yevmiye kaydının hâlâ etkin mahsupları var. İptal etmeden önce bunları ERPNext'te çözün (mutabakatı geri alın veya bağlantıyı kaldırın)."

#: card/cash_disbursement.py
msgid "Journal entry {0} pays cash payment {1}. Request its cancellation with a reason first; the payment is then marked Cancelled."
msgstr "{0} yevmiye kaydı {1} nakit ödemesini kapatıyor. Önce bir nedenle iptal talep edin; ödeme bundan sonra İptal Edildi olarak işaretlenir."
