{
  "name": "card-docs",
  "private": true,
  "type": "module",
  "description": "CARD documentation site (Astro Starlight), published to GitHub Pages",
  "scripts": {
    "generate": "python3 scripts/generate_reference.py",
    "check:reference": "python3 scripts/generate_reference.py --check",
    "dev": "npm run generate && astro dev",
    "build": "npm run generate && astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.10",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "astro": "7.4.8",
    "sharp": "0.35.5"
  }
}
