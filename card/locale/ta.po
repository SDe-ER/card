#: card/cash_disbursement.py
msgid "A cash payment is already requested for row {0} of card {1}."
msgstr "வரிசை {0}, அட்டை {1}க்கான ரொக்கக் கட்டணம் ஏற்கனவே கோரப்பட்டுள்ளது."

#: card/cash_disbursement.py
msgid "A cash payment is requested on a Draft card only."
msgstr "ரொக்கக் கட்டணத்தை வரைவு அட்டைக்கு மட்டுமே கோர முடியும்."

#: card/cash_disbursement.py
msgid "Give the reason for the cancellation."
msgstr "ரத்து செய்வதற்கான காரணத்தைக் குறிப்பிடவும்."

#: card/cash_disbursement.py
msgid "Only a cancelled cash payment can be replaced; {0} is {1}."
msgstr "ரத்து செய்யப்பட்ட ரொக்கக் கட்டணத்தை மட்டுமே மாற்ற முடியும்; {0} நிலை {1}."

#: card/cash_disbursement.py
msgid "Only a Card Manager can approve a cash payment."
msgstr "அட்டை மேலாளர் மட்டுமே ரொக்கக் கட்டணத்தை அங்கீகரிக்க முடியும்."

#: card/cash_disbursement.py
msgid "Only a Card Manager can post a cash payment."
msgstr "அட்டை மேலாளர் மட்டுமே ரொக்கக் கட்டணத்தைப் பதிவு செய்ய முடியும்."

#: card/cash_disbursement.py
msgid "Only a Card Manager can request a cancellation."
msgstr "அட்டை மேலாளர் மட்டுமே ரத்து செய்யக் கோர முடியும்."

#: card/cash_disbursement.py
msgid "Only a Card Manager can request a replacement."
msgstr "அட்டை மேலாளர் மட்டுமே மாற்றுக்குக் கோர முடியும்."

#: card/cash_disbursement.py
msgid "Only a Pending cash payment can be approved; {0} is {1}."
msgstr "நிலுவையில் உள்ள ரொக்கக் கட்டணத்தை மட்டுமே அங்கீகரிக்க முடியும்; {0} நிலை {1}."

#: card/cash_disbursement.py
msgid "Only a posted cash payment can be cancelled; {0} is {1}."
msgstr "பதிவு செய்யப்பட்ட ரொக்கக் கட்டணத்தை மட்டுமே ரத்து செய்ய முடியும்; {0} நிலை {1}."

#: card/cash_disbursement.py
msgid "Only a queued cash payment can be executed; {0} is {1}."
msgstr "வரிசையில் உள்ள ரொக்கக் கட்டணத்தை மட்டுமே செயல்படுத்த முடியும்; {0} நிலை {1}."

#: card/cash_disbursement.py
msgid "Only an approved cash payment can be queued for posting; {0} is {1}."
msgstr "அங்கீகரிக்கப்பட்ட ரொக்கக் கட்டணத்தை மட்டுமே பதிவுக்கான வரிசையில் சேர்க்க முடியும்; {0} நிலை {1}."

#: card/cash_disbursement.py
msgid "Row {0} of card {1} already has a live cash payment ({2})."
msgstr "அட்டை {1}ன் வரிசை {0}க்கு ஏற்கனவே செயலில் உள்ள ரொக்கக் கட்டணம் ({2}) உள்ளது."

#: card/cash_disbursement.py
msgid "The cash payment {0} does not exist."
msgstr "ரொக்கக் கட்டணம் {0} இல்லை."

#: card/cash_disbursement.py
msgid "The cash payment {0} is {1}; it cannot be deleted. Cancel it instead."
msgstr "ரொக்கக் கட்டணம் {0} நிலை {1}; அதை நீக்க முடியாது. அதற்குப் பதிலாக ரத்து செய்யவும்."

#: card/cash_disbursement.py
msgid "The requester cannot approve their own cash payment."
msgstr "கோருபவர் தமது சொந்த ரொக்கக் கட்டணத்தை அங்கீகரிக்க முடியாது."

#: card/cash_disbursement.py
msgid "The row {0} is no longer on card {1}."
msgstr "வரிசை {0} இனி அட்டை {1}இல் இல்லை."

#: card/cash_disbursement.py
msgid "The row {0} is not a cash payment on card {1}."
msgstr "வரிசை {0} அட்டை {1}இல் ரொக்கக் கட்டணம் அல்ல."

#: card/cash_disbursement.py
msgid "The cash payment {0} is approved; {1} cannot be changed. Cancel it and request a replacement."
msgstr "ரொக்கக் கட்டணம் {0} அங்கீகரிக்கப்பட்டுள்ளது; {1} மாற்ற முடியாது. அதை ரத்து செய்து மாற்றுக்குக் கோரவும்."

#: card/cash_disbursement.py
msgid "Journal entry {0} still has active allocations. Resolve them in ERPNext (unreconcile or unlink) before cancelling it."
msgstr "பதிவேட்டு உள்ளீடு {0}க்கு இன்னும் செயலில் உள்ள ஒதுக்கீடுகள் உள்ளன. ரத்து செய்வதற்கு முன் ERPNext இல் அவற்றைத் தீர்க்கவும் (சமரசத்தை நீக்கு அல்லது இணைப்பை நீக்கு)."

#: card/cash_disbursement.py
msgid "Journal entry {0} pays cash payment {1}. Request its cancellation with a reason first; the payment is then marked Cancelled."
msgstr "பதிவேட்டு உள்ளீடு {0} ரொக்கக் கட்டணம் {1}ஐ செலுத்துகிறது. முதலில் காரணத்துடன் ரத்துக்குக் கோரவும்; அதன் பின் கட்டணம் ரத்து செய்யப்பட்டது எனக் குறிக்கப்படும்."

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Pending approval"
msgstr "ஒப்புதலுக்காகக் காத்திருக்கிறது"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Queued for posting"
msgstr "பதிவுக்கான வரிசையில்"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Posting failed"
msgstr "பதிவு தோல்வியடைந்தது"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Cancellation requested"
msgstr "ரத்துக்குக் கோரப்பட்டது"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Not reconciled"
msgstr "சமரசம் செய்யப்படவில்லை"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Partially reconciled"
msgstr "பகுதியாகச் சமரசம்"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Fully reconciled"
msgstr "முழுமையாகச் சமரசம்"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Approve this cash payment? The approver must not be the requester."
msgstr "இந்த ரொக்கக் கட்டணத்தை அங்கீகரிக்கவா? அங்கீகரிப்பவர் கோரியவராக இருக்கக்கூடாது."

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Queue for posting"
msgstr "பதிவுக்கான வரிசையில் சேர்"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Retry posting"
msgstr "பதிவை மீண்டும் முயற்சி"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Request cancellation"
msgstr "ரத்துக்குக் கோரு"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Cash: pending approval"
msgstr "ரொக்கம்: ஒப்புதல் நிலுவையில்"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Cash: approved"
msgstr "ரொக்கம்: அங்கீகரிக்கப்பட்டது"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Cash: queued for posting"
msgstr "ரொக்கம்: வரிசையில்"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Cash: posting failed"
msgstr "ரொக்கம்: பதிவு தோல்வி"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Cash: posted"
msgstr "ரொக்கம்: பதிவு செய்யப்பட்டது"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Cash: cancellation requested"
msgstr "ரொக்கம்: ரத்துக்குக் கோரப்பட்டது"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Cash: cancelled"
msgstr "ரொக்கம்: ரத்து செய்யப்பட்டது"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Cash: not reconciled"
msgstr "ரொக்கம்: சமரசம் இல்லை"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Cash: partially reconciled"
msgstr "ரொக்கம்: பகுதியாகச் சமரசம்"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Cash: fully reconciled"
msgstr "ரொக்கம்: முழுமையாகச் சமரசம்"

