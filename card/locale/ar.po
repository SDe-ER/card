msgstr "مجموعة الأصناف {0} عليها قوالب ضريبة؛ يجب أن تكون بدونها."

msgid "Reconciliation mismatch on card {0} ({1} side): invoice lines total {2} but the card stores {3}."
msgstr "عدم تطابق في كارت {0} (جانب {1}): إجمالي بنود الفاتورة {2} بينما الكارت يخزن {3}."

msgid "Monthly operation card {0} — {1}"
