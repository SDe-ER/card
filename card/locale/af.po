#: card/cash_disbursement.py
msgid "A cash payment is already requested for row {0} of card {1}."
msgstr "'n Kontantbetaling is reeds vir ry {0} van kaart {1} aangevra."

#: card/cash_disbursement.py
msgid "A cash payment is requested on a Draft card only."
msgstr "'n Kontantbetaling word slegs op 'n konsep-kaart aangevra."

#: card/cash_disbursement.py
msgid "Give the reason for the cancellation."
msgstr "Gee die rede vir die kansellasie."

#: card/cash_disbursement.py
msgid "Only a cancelled cash payment can be replaced; {0} is {1}."
msgstr "Slegs 'n gekanselleerde kontantbetaling kan vervang word; {0} is {1}."

#: card/cash_disbursement.py
msgid "Only a Card Manager can approve a cash payment."
msgstr "Slegs 'n Kaartbestuurder kan 'n kontantbetaling goedkeur."

#: card/cash_disbursement.py
msgid "Only a Card Manager can post a cash payment."
msgstr "Slegs 'n Kaartbestuurder kan 'n kontantbetaling bemark."

#: card/cash_disbursement.py
msgid "Only a Card Manager can request a cancellation."
msgstr "Slegs 'n Kaartbestuurder kan 'n kansellasie aanvra."

#: card/cash_disbursement.py
msgid "Only a Card Manager can request a replacement."
msgstr "Slegs 'n Kaartbestuurder kan 'n vervanging aanvra."

#: card/cash_disbursement.py
msgid "Only a Pending cash payment can be approved; {0} is {1}."
msgstr "Slegs 'n hangende kontantbetaling kan goedgekeur word; {0} is {1}."

#: card/cash_disbursement.py
msgid "Only a posted cash payment can be cancelled; {0} is {1}."
msgstr "Slegs 'n geboekte kontantbetaling kan gekanselleer word; {0} is {1}."

#: card/cash_disbursement.py
msgid "Only a queued cash payment can be executed; {0} is {1}."
msgstr "Slegs 'n kontantbetaling in die ry kan uitgevoer word; {0} is {1}."

#: card/cash_disbursement.py
msgid "Only an approved cash payment can be queued for posting; {0} is {1}."
msgstr "Slegs 'n goedgekeurde kontantbetaling kan vir bemarking in die ry geplaas word; {0} is {1}."

#: card/cash_disbursement.py
msgid "Row {0} of card {1} already has a live cash payment ({2})."
msgstr "Ry {0} van kaart {1} het reeds 'n aktiewe kontantbetaling ({2})."

#: card/cash_disbursement.py
msgid "The cash payment {0} does not exist."
msgstr "Die kontantbetaling {0} bestaan nie."

#: card/cash_disbursement.py
msgid "The cash payment {0} is {1}; it cannot be deleted. Cancel it instead."
msgstr "Die kontantbetaling {0} is {1}; dit kan nie uitgevee word nie. Kanselleer dit eerder."

#: card/cash_disbursement.py
msgid "The requester cannot approve their own cash payment."
msgstr "Die aanvraer kan nie hul eie kontantbetaling goedkeur nie."

#: card/cash_disbursement.py
msgid "The row {0} is no longer on card {1}."
msgstr "Ry {0} is nie meer op kaart {1} nie."

#: card/cash_disbursement.py
msgid "The row {0} is not a cash payment on card {1}."
msgstr "Ry {0} is nie 'n kontantbetaling op kaart {1} nie."

#: card/cash_disbursement.py
msgid "The cash payment {0} is approved; {1} cannot be changed. Cancel it and request a replacement."
msgstr "Die kontantbetaling {0} is goedgekeur; {1} kan nie verander word nie. Kanselleer dit en vra 'n vervanging aan."

#: card/cash_disbursement.py
msgid "Journal entry {0} still has active allocations. Resolve them in ERPNext (unreconcile or unlink) before cancelling it."
msgstr "Joernaalinskrywing {0} het steeds aktiewe toewysings. Los dit op in ERPNext (ontkoppel of ontskakel) voordat dit gekanselleer word."

#: card/cash_disbursement.py
msgid "Journal entry {0} pays cash payment {1}. Request its cancellation with a reason first; the payment is then marked Cancelled."
msgstr "Joernaalinskrywing {0} betaal kontantbetaling {1}. Vra eers die kansellasie met 'n rede aan; die betaling word dan as Gekanselleer gemerk."
