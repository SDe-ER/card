msgstr "قيمة التعبئة"

msgid "Transport cost"
msgstr "تكلفة النقل"

msgid "Amount in words"
msgstr "المبلغ كتابةً"

msgid "You are not permitted to build postings for company {0}."
msgstr "غير مسموح لك بإنشاء ترحيلات للشركة {0}."

msgid "Figures per company"
msgstr "الأرقام حسب الشركة"

msgid "Reason for commercial change"
msgstr "سبب تغيير الشروط التجارية"

msgid "Required when a commercial term (rate, rate type, daily hours, direction, parties, contract, fuel) changes; kept in the document history."
msgstr "مطلوب عند تغيير أي شرط تجاري (السعر، نوع السعر، الساعات اليومية، الاتجاه، الأطراف، العقد، الوقود)، ويُحفظ في سجل المستند."

msgid "Enter the reason for changing the commercial terms: {0}"
msgstr "أدخل سبب تغيير الشروط التجارية: {0}"

