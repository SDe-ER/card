#: card/cash_disbursement.py
msgid "A cash payment is already requested for row {0} of card {1}."
msgstr "Un paiement en espèces a déjà été demandé pour la ligne {0} de la carte {1}."

#: card/cash_disbursement.py
msgid "A cash payment is requested on a Draft card only."
msgstr "Un paiement en espèces ne peut être demandé que sur une carte à l'état brouillon."

#: card/cash_disbursement.py
msgid "Give the reason for the cancellation."
msgstr "Indiquez le motif de l'annulation."

#: card/cash_disbursement.py
msgid "Only a cancelled cash payment can be replaced; {0} is {1}."
msgstr "Seul un paiement en espèces annulé peut être remplacé ; {0} est {1}."

#: card/cash_disbursement.py
msgid "Only a Card Manager can approve a cash payment."
msgstr "Seul un gestionnaire de cartes peut approuver un paiement en espèces."

#: card/cash_disbursement.py
msgid "Only a Card Manager can post a cash payment."
msgstr "Seul un gestionnaire de cartes peut comptabiliser un paiement en espèces."

#: card/cash_disbursement.py
msgid "Only a Card Manager can request a cancellation."
msgstr "Seul un gestionnaire de cartes peut demander une annulation."

#: card/cash_disbursement.py
msgid "Only a Card Manager can request a replacement."
msgstr "Seul un gestionnaire de cartes peut demander un remplacement."

#: card/cash_disbursement.py
msgid "Only a Pending cash payment can be approved; {0} is {1}."
msgstr "Seul un paiement en espèces en attente peut être approuvé ; {0} est {1}."

#: card/cash_disbursement.py
msgid "Only a posted cash payment can be cancelled; {0} is {1}."
msgstr "Seul un paiement en espèces comptabilisé peut être annulé ; {0} est {1}."

#: card/cash_disbursement.py
msgid "Only a queued cash payment can be executed; {0} is {1}."
msgstr "Seul un paiement en espèces en file d'attente peut être exécuté ; {0} est {1}."

#: card/cash_disbursement.py
msgid "Only an approved cash payment can be queued for posting; {0} is {1}."
msgstr "Seul un paiement en espèces approuvé peut être mis en file d'attente pour comptabilisation ; {0} est {1}."

#: card/cash_disbursement.py
msgid "Row {0} of card {1} already has a live cash payment ({2})."
msgstr "La ligne {0} de la carte {1} a déjà un paiement en espèces actif ({2})."

#: card/cash_disbursement.py
msgid "The cash payment {0} does not exist."
msgstr "Le paiement en espèces {0} n'existe pas."

#: card/cash_disbursement.py
msgid "The cash payment {0} is {1}; it cannot be deleted. Cancel it instead."
msgstr "Le paiement en espèces {0} est {1} ; il ne peut pas être supprimé. Annulez-le à la place."

#: card/cash_disbursement.py
msgid "The requester cannot approve their own cash payment."
msgstr "Le demandeur ne peut pas approuver son propre paiement en espèces."

#: card/cash_disbursement.py
msgid "The row {0} is no longer on card {1}."
msgstr "La ligne {0} ne figure plus sur la carte {1}."

#: card/cash_disbursement.py
msgid "The row {0} is not a cash payment on card {1}."
msgstr "La ligne {0} n'est pas un paiement en espèces sur la carte {1}."

#: card/cash_disbursement.py
msgid "The cash payment {0} is approved; {1} cannot be changed. Cancel it and request a replacement."
msgstr "Le paiement en espèces {0} est approuvé ; {1} ne peut plus être modifié. Annulez-le et demandez un remplacement."

#: card/cash_disbursement.py
msgid "Journal entry {0} still has active allocations. Resolve them in ERPNext (unreconcile or unlink) before cancelling it."
msgstr "L'écriture de journal {0} a encore des imputations actives. Régularisez-les dans ERPNext (annulation du rapprochement ou dissociation) avant de l'annuler."

#: card/cash_disbursement.py
msgid "Journal entry {0} pays cash payment {1}. Request its cancellation with a reason first; the payment is then marked Cancelled."
msgstr "L'écriture de journal {0} règle le paiement en espèces {1}. Demandez d'abord l'annulation avec un motif ; le paiement sera alors marqué Annulé."

