#: card/cash_disbursement.py
msgid "A cash payment is already requested for row {0} of card {1}."
msgstr "Đã yêu cầu thanh toán tiền mặt cho dòng {0} của thẻ {1}."

#: card/cash_disbursement.py
msgid "A cash payment is requested on a Draft card only."
msgstr "Chỉ có thể yêu cầu thanh toán tiền mặt cho thẻ ở trạng thái nháp."

#: card/cash_disbursement.py
msgid "Give the reason for the cancellation."
msgstr "Nhập lý do hủy."

#: card/cash_disbursement.py
msgid "Only a cancelled cash payment can be replaced; {0} is {1}."
msgstr "Chỉ có thể thay thế khoản thanh toán tiền mặt đã hủy; {0} đang ở trạng thái {1}."

#: card/cash_disbursement.py
msgid "Only a Card Manager can approve a cash payment."
msgstr "Chỉ Quản lý thẻ mới có thể phê duyệt thanh toán tiền mặt."

#: card/cash_disbursement.py
msgid "Only a Card Manager can post a cash payment."
msgstr "Chỉ Quản lý thẻ mới có thể ghi sổ thanh toán tiền mặt."

#: card/cash_disbursement.py
msgid "Only a Card Manager can request a cancellation."
msgstr "Chỉ Quản lý thẻ mới có thể yêu cầu hủy."

#: card/cash_disbursement.py
msgid "Only a Card Manager can request a replacement."
msgstr "Chỉ Quản lý thẻ mới có thể yêu cầu thay thế."

#: card/cash_disbursement.py
msgid "Only a Pending cash payment can be approved; {0} is {1}."
msgstr "Chỉ có thể phê duyệt thanh toán tiền mặt đang chờ; {0} đang ở trạng thái {1}."

#: card/cash_disbursement.py
msgid "Only a posted cash payment can be cancelled; {0} is {1}."
msgstr "Chỉ có thể hủy thanh toán tiền mặt đã ghi sổ; {0} đang ở trạng thái {1}."

#: card/cash_disbursement.py
msgid "Only a queued cash payment can be executed; {0} is {1}."
msgstr "Chỉ có thể thực hiện thanh toán tiền mặt đang xếp hàng; {0} đang ở trạng thái {1}."

#: card/cash_disbursement.py
msgid "Only an approved cash payment can be queued for posting; {0} is {1}."
msgstr "Chỉ có thể xếp hàng ghi sổ thanh toán tiền mặt đã phê duyệt; {0} đang ở trạng thái {1}."

#: card/cash_disbursement.py
msgid "Row {0} of card {1} already has a live cash payment ({2})."
msgstr "Dòng {0} của thẻ {1} đã có một thanh toán tiền mặt đang hoạt động ({2})."

#: card/cash_disbursement.py
msgid "The cash payment {0} does not exist."
msgstr "Thanh toán tiền mặt {0} không tồn tại."

#: card/cash_disbursement.py
msgid "The cash payment {0} is {1}; it cannot be deleted. Cancel it instead."
msgstr "Thanh toán tiền mặt {0} đang ở trạng thái {1}; không thể xóa. Hãy hủy thay thế."

#: card/cash_disbursement.py
msgid "The requester cannot approve their own cash payment."
msgstr "Người yêu cầu không thể tự phê duyệt thanh toán tiền mặt của mình."

#: card/cash_disbursement.py
msgid "The row {0} is no longer on card {1}."
msgstr "Dòng {0} không còn trên thẻ {1}."

#: card/cash_disbursement.py
msgid "The row {0} is not a cash payment on card {1}."
msgstr "Dòng {0} không phải là thanh toán tiền mặt trên thẻ {1}."

#: card/cash_disbursement.py
msgid "The cash payment {0} is approved; {1} cannot be changed. Cancel it and request a replacement."
msgstr "Thanh toán tiền mặt {0} đã được phê duyệt; không thể thay đổi {1}. Hãy hủy và yêu cầu thay thế."

#: card/cash_disbursement.py
msgid "Journal entry {0} still has active allocations. Resolve them in ERPNext (unreconcile or unlink) before cancelling it."
msgstr "Bút toán {0} vẫn còn phân bổ đang hoạt động. Hãy xử lý trong ERPNext (hủy đối chiếu hoặc gỡ liên kết) trước khi hủy."

#: card/cash_disbursement.py
msgid "Journal entry {0} pays cash payment {1}. Request its cancellation with a reason first; the payment is then marked Cancelled."
msgstr "Bút toán {0} thanh toán khoản thanh toán tiền mặt {1}. Hãy yêu cầu hủy kèm lý do trước; khoản thanh toán sau đó sẽ được đánh dấu là Đã hủy."

