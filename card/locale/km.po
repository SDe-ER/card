#: card/cash_disbursement.py
msgid "A cash payment is already requested for row {0} of card {1}."
msgstr "ការបង់ប្រាក់សាច់ប្រាក់សម្រាប់ជួរ {0} នៃកាត {1} ត្រូវបានស្នើរួចហើយ។"

#: card/cash_disbursement.py
msgid "A cash payment is requested on a Draft card only."
msgstr "ការបង់ប្រាក់សាច់ប្រាក់អាចស្នើបានតែលើកាតសេចក្តីព្រាង។"

#: card/cash_disbursement.py
msgid "Give the reason for the cancellation."
msgstr "សូមផ្តល់មូលហេតុនៃការលុបចោល។"

#: card/cash_disbursement.py
msgid "Only a cancelled cash payment can be replaced; {0} is {1}."
msgstr "អាចជំនួសបានតែការបង់ប្រាក់សាច់ប្រាក់ដែលបានលុបចោលប៉ុណ្ណោះ; {0} គឺ {1}។"

#: card/cash_disbursement.py
msgid "Only a Card Manager can approve a cash payment."
msgstr "មានតែអ្នកគ្រប់គ្រងកាតប៉ុណ្ណោះដែលអាចអនុម័តការបង់ប្រាក់សាច់ប្រាក់។"

#: card/cash_disbursement.py
msgid "Only a Card Manager can post a cash payment."
msgstr "មានតែអ្នកគ្រប់គ្រងកាតប៉ុណ្ណោះដែលអាចបញ្ចូលការបង់ប្រាក់សាច់ប្រាក់ទៅក្នុងសៀវភៅ។"

#: card/cash_disbursement.py
msgid "Only a Card Manager can request a cancellation."
msgstr "មានតែអ្នកគ្រប់គ្រងកាតប៉ុណ្ណោះដែលអាចស្នើការលុបចោល។"

#: card/cash_disbursement.py
msgid "Only a Card Manager can request a replacement."
msgstr "មានតែអ្នកគ្រប់គ្រងកាតប៉ុណ្ណោះដែលអាចស្នើការជំនួស។"

#: card/cash_disbursement.py
msgid "Only a Pending cash payment can be approved; {0} is {1}."
msgstr "អាចអនុម័តបានតែការបង់ប្រាក់សាច់ប្រាក់ដែលកំពុងរង់ចាំប៉ុណ្ណោះ; {0} គឺ {1}។"

#: card/cash_disbursement.py
msgid "Only a posted cash payment can be cancelled; {0} is {1}."
msgstr "អាចលុបចោលបានតែការបង់ប្រាក់សាច់ប្រាក់ដែលបានបញ្ចូលក្នុងសៀវភៅប៉ុណ្ណោះ; {0} គឺ {1}។"

#: card/cash_disbursement.py
msgid "Only a queued cash payment can be executed; {0} is {1}."
msgstr "អាចប្រតិបត្តិបានតែការបង់ប្រាក់សាច់ប្រាក់ដែលនៅក្នុងជួរប៉ុណ្ណោះ; {0} គឺ {1}។"

#: card/cash_disbursement.py
msgid "Only an approved cash payment can be queued for posting; {0} is {1}."
msgstr "អាចដាក់ចូលជួរសម្រាប់បញ្ចូលក្នុងសៀវភៅបានតែការបង់ប្រាក់សាច់ប្រាក់ដែលបានអនុម័តប៉ុណ្ណោះ; {0} គឺ {1}។"

#: card/cash_disbursement.py
msgid "Row {0} of card {1} already has a live cash payment ({2})."
msgstr "ជួរ {0} នៃកាត {1} មានការបង់ប្រាក់សាច់ប្រាក់សកម្មរួចហើយ ({2})។"

#: card/cash_disbursement.py
msgid "The cash payment {0} does not exist."
msgstr "ការបង់ប្រាក់សាច់ប្រាក់ {0} មិនមានទេ។"

#: card/cash_disbursement.py
msgid "The cash payment {0} is {1}; it cannot be deleted. Cancel it instead."
msgstr "ការបង់ប្រាក់សាច់ប្រាក់ {0} គឺ {1}; មិនអាចលុបបានទេ។ សូមលុបចោលវាជំនួសវិញ។"

#: card/cash_disbursement.py
msgid "The requester cannot approve their own cash payment."
msgstr "អ្នកស្នើមិនអាចអនុម័តការបង់ប្រាក់សាច់ប្រាក់របស់ខ្លួនបានទេ។"

#: card/cash_disbursement.py
msgid "The row {0} is no longer on card {1}."
msgstr "ជួរ {0} លែងនៅលើកាត {1} ទៀតហើយ។"

#: card/cash_disbursement.py
msgid "The row {0} is not a cash payment on card {1}."
msgstr "ជួរ {0} មិនមែនជាការបង់ប្រាក់សាច់ប្រាក់នៅលើកាត {1} ទេ។"

#: card/cash_disbursement.py
msgid "The cash payment {0} is approved; {1} cannot be changed. Cancel it and request a replacement."
msgstr "ការបង់ប្រាក់សាច់ប្រាក់ {0} ត្រូវបានអនុម័ត; {1} មិនអាចផ្លាស់ប្តូរបានទេ។ សូមលុបចោលវា ហើយស្នើការជំនួស។"

#: card/cash_disbursement.py
msgid "Journal entry {0} still has active allocations. Resolve them in ERPNext (unreconcile or unlink) before cancelling it."
msgstr "ធាតុកាសែត {0} នៅមានការបែងចែកសកម្ម។ សូមដោះស្រាយវាក្នុង ERPNext (ដកការផ្សះផ្សា ឬផ្តាច់ការភ្ជាប់) មុនពេលលុបចោល។"

#: card/cash_disbursement.py
msgid "Journal entry {0} pays cash payment {1}. Request its cancellation with a reason first; the payment is then marked Cancelled."
msgstr "ធាតុកាសែត {0} បង់ការបង់ប្រាក់សាច់ប្រាក់ {1}។ សូមស្នើការលុបចោលជាមួយមូលហេតុជាមុនសិន; បន្ទាប់មកការបង់ប្រាក់នឹងត្រូវបានសម្គាល់ថាបានលុបចោល។"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Pending approval"
msgstr "កំពុងរង់ចាំការអនុម័ត"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Queued for posting"
msgstr "នៅក្នុងជួរសម្រាប់បញ្ចូលសៀវភៅ"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Posting failed"
msgstr "ការបញ្ចូលសៀវភៅបានបរាជ័យ"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Cancellation requested"
msgstr "បានស្នើការលុបចោល"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Not reconciled"
msgstr "មិនទាន់ផ្សះផ្សា"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Partially reconciled"
msgstr "បានផ្សះផ្សាមួយផ្នែក"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Fully reconciled"
msgstr "បានផ្សះផ្សាពេញលេញ"

