#: card/cash_disbursement.py
msgid "A cash payment is already requested for row {0} of card {1}."
msgstr "Er is al een contante betaling aangevraagd voor regel {0} van kaart {1}."

#: card/cash_disbursement.py
msgid "A cash payment is requested on a Draft card only."
msgstr "Een contante betaling kan alleen worden aangevraagd voor een concept-kaart."

#: card/cash_disbursement.py
msgid "Give the reason for the cancellation."
msgstr "Geef de reden voor de annulering."

#: card/cash_disbursement.py
msgid "Only a cancelled cash payment can be replaced; {0} is {1}."
msgstr "Alleen een geannuleerde contante betaling kan worden vervangen; {0} is {1}."

#: card/cash_disbursement.py
msgid "Only a Card Manager can approve a cash payment."
msgstr "Alleen een kaartbeheerder kan een contante betaling goedkeuren."

#: card/cash_disbursement.py
msgid "Only a Card Manager can post a cash payment."
msgstr "Alleen een kaartbeheerder kan een contante betaling boeken."

#: card/cash_disbursement.py
msgid "Only a Card Manager can request a cancellation."
msgstr "Alleen een kaartbeheerder kan een annulering aanvragen."

#: card/cash_disbursement.py
msgid "Only a Card Manager can request a replacement."
msgstr "Alleen een kaartbeheerder kan een vervanging aanvragen."

#: card/cash_disbursement.py
msgid "Only a Pending cash payment can be approved; {0} is {1}."
msgstr "Alleen een openstaande contante betaling kan worden goedgekeurd; {0} is {1}."

#: card/cash_disbursement.py
msgid "Only a posted cash payment can be cancelled; {0} is {1}."
msgstr "Alleen een geboekte contante betaling kan worden geannuleerd; {0} is {1}."

#: card/cash_disbursement.py
msgid "Only a queued cash payment can be executed; {0} is {1}."
msgstr "Alleen een contante betaling in de wachtrij kan worden uitgevoerd; {0} is {1}."

#: card/cash_disbursement.py
msgid "Only an approved cash payment can be queued for posting; {0} is {1}."
msgstr "Alleen een goedgekeurde contante betaling kan in de boekingswachtrij worden geplaatst; {0} is {1}."

#: card/cash_disbursement.py
msgid "Row {0} of card {1} already has a live cash payment ({2})."
msgstr "Regel {0} van kaart {1} heeft al een actieve contante betaling ({2})."

#: card/cash_disbursement.py
msgid "The cash payment {0} does not exist."
msgstr "De contante betaling {0} bestaat niet."

#: card/cash_disbursement.py
msgid "The cash payment {0} is {1}; it cannot be deleted. Cancel it instead."
msgstr "De contante betaling {0} is {1}; ze kan niet worden verwijderd. Annuleer haar in plaats daarvan."

#: card/cash_disbursement.py
msgid "The requester cannot approve their own cash payment."
msgstr "De aanvrager kan zijn eigen contante betaling niet goedkeuren."

#: card/cash_disbursement.py
msgid "The row {0} is no longer on card {1}."
msgstr "Regel {0} staat niet meer op kaart {1}."

#: card/cash_disbursement.py
msgid "The row {0} is not a cash payment on card {1}."
msgstr "Regel {0} is geen contante betaling op kaart {1}."

#: card/cash_disbursement.py
msgid "The cash payment {0} is approved; {1} cannot be changed. Cancel it and request a replacement."
msgstr "De contante betaling {0} is goedgekeurd; {1} kan niet meer worden gewijzigd. Annuleer haar en vraag een vervanging aan."

#: card/cash_disbursement.py
msgid "Journal entry {0} still has active allocations. Resolve them in ERPNext (unreconcile or unlink) before cancelling it."
msgstr "Journaalpost {0} heeft nog actieve toewijzingen. Los die op in ERPNext (koppeling of toewijzing verwijderen) voordat u de post annuleert."

#: card/cash_disbursement.py
msgid "Journal entry {0} pays cash payment {1}. Request its cancellation with a reason first; the payment is then marked Cancelled."
msgstr "Journaalpost {0} vereffent contante betaling {1}. Vraag eerst de annulering met een reden aan; de betaling krijgt dan de status Geannuleerd."
