#: card/cash_disbursement.py
msgid "A cash payment is already requested for row {0} of card {1}."
msgstr "Der er allerede anmodet om en kontantbetaling for linje {0} på kort {1}."

#: card/cash_disbursement.py
msgid "A cash payment is requested on a Draft card only."
msgstr "Der kan kun anmodes om en kontantbetaling på et kladdekort."

#: card/cash_disbursement.py
msgid "Give the reason for the cancellation."
msgstr "Angiv årsagen til annulleringen."

#: card/cash_disbursement.py
msgid "Only a cancelled cash payment can be replaced; {0} is {1}."
msgstr "Kun en annulleret kontantbetaling kan erstattes; {0} er {1}."

#: card/cash_disbursement.py
msgid "Only a Card Manager can approve a cash payment."
msgstr "Kun en kortadministrator kan godkende en kontantbetaling."

#: card/cash_disbursement.py
msgid "Only a Card Manager can post a cash payment."
msgstr "Kun en kortadministrator kan bogføre en kontantbetaling."

#: card/cash_disbursement.py
msgid "Only a Card Manager can request a cancellation."
msgstr "Kun en kortadministrator kan anmode om annullering."

#: card/cash_disbursement.py
msgid "Only a Card Manager can request a replacement."
msgstr "Kun en kortadministrator kan anmode om erstatning."

#: card/cash_disbursement.py
msgid "Only a Pending cash payment can be approved; {0} is {1}."
msgstr "Kun en afventende kontantbetaling kan godkendes; {0} er {1}."

#: card/cash_disbursement.py
msgid "Only a posted cash payment can be cancelled; {0} is {1}."
msgstr "Kun en bogført kontantbetaling kan annulleres; {0} er {1}."

#: card/cash_disbursement.py
msgid "Only a queued cash payment can be executed; {0} is {1}."
msgstr "Kun en kontantbetaling i køen kan udføres; {0} er {1}."

#: card/cash_disbursement.py
msgid "Only an approved cash payment can be queued for posting; {0} is {1}."
msgstr "Kun en godkendt kontantbetaling kan sættes i kø til bogføring; {0} er {1}."

#: card/cash_disbursement.py
msgid "Row {0} of card {1} already has a live cash payment ({2})."
msgstr "Linje {0} på kort {1} har allerede en aktiv kontantbetaling ({2})."

#: card/cash_disbursement.py
msgid "The cash payment {0} does not exist."
msgstr "Kontantbetalingen {0} findes ikke."

#: card/cash_disbursement.py
msgid "The cash payment {0} is {1}; it cannot be deleted. Cancel it instead."
msgstr "Kontantbetalingen {0} er {1}; den kan ikke slettes. Annuller den i stedet."

#: card/cash_disbursement.py
msgid "The requester cannot approve their own cash payment."
msgstr "Den, der anmoder, kan ikke godkende sin egen kontantbetaling."

#: card/cash_disbursement.py
msgid "The row {0} is no longer on card {1}."
msgstr "Linje {0} er ikke længere på kort {1}."

#: card/cash_disbursement.py
msgid "The row {0} is not a cash payment on card {1}."
msgstr "Linje {0} er ikke en kontantbetaling på kort {1}."

#: card/cash_disbursement.py
msgid "The cash payment {0} is approved; {1} cannot be changed. Cancel it and request a replacement."
msgstr "Kontantbetalingen {0} er godkendt; {1} kan ikke ændres. Annuller den og anmod om erstatning."

#: card/cash_disbursement.py
msgid "Journal entry {0} still has active allocations. Resolve them in ERPNext (unreconcile or unlink) before cancelling it."
msgstr "Postering {0} har stadig aktive tildelinger. Afklar dem i ERPNext (fjern afstemningen eller fjern forbindelsen), før den annulleres."

#: card/cash_disbursement.py
msgid "Journal entry {0} pays cash payment {1}. Request its cancellation with a reason first; the payment is then marked Cancelled."
msgstr "Postering {0} betaler kontantbetaling {1}. Anmod først om annullering med en begrundelse; betalingen markeres derefter som Annulleret."

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Pending approval"
msgstr "Afventer godkendelse"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Queued for posting"
msgstr "I kø til bogføring"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Posting failed"
msgstr "Bogføring mislykkedes"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Cancellation requested"
msgstr "Annullering anmodet"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Not reconciled"
msgstr "Ikke afstemt"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
