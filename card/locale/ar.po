msgid "The card has no supplier; a supplier-side addition/deduction needs one: {0}."
msgstr "الكارت بلا مورد؛ الإضافة/الخصم على جانب المورد تحتاج مورداً: {0}."

msgid "Configure Card Settings for company {0}: {1} is not set."
msgstr "قم بإعداد إعدادات كارت للشركة {0}: ‏{1} غير محدد."

msgid "Accounting posting is disabled; enable it in Card Settings first."
msgstr "الترحيل المحاسبي معطّل؛ فعّله من إعدادات كارت أولاً."

msgid "{0} {1} ({2}) must be an active leaf record of company {3}."
msgstr "{0} {1} ({2}) يجب أن يكون سجلاً فرعياً فعالاً للشركة {3}."

msgid "No fiscal year covers {0} for company {1}; create it before posting."
msgstr "لا توجد سنة مالية تغطي {0} للشركة {1}؛ أنشئها قبل الترحيل."

msgid "Fiscal year {0} is disabled; nothing can be posted into it."
msgstr "السنة المالية {0} معطّلة؛ لا يمكن الترحيل فيها."

msgid "Accounting period {0} is closed for {1}; choose another posting date."
msgstr "الفترة المحاسبية {0} مقفلة لـ{1}؛ اختر تاريخ ترحيل آخر."

msgid "Books are frozen up to {0} for company {1}; the posting date {2} is inside the frozen period."
msgstr "الدفاتر مجمّدة حتى {0} للشركة {1}؛ تاريخ الترحيل {2} داخل فترة التجميد."

msgid "Card period lock: {0} is on or before the lock date {1}; posting is blocked."
msgstr "قفل فترة كارت: ‏{0} في أو قبل تاريخ القفل {1}؛ الترحيل ممنوع."

msgid "Selling Settings validates selling prices, which rejects deduction lines; disable it before posting."
msgstr "إعدادات البيع تتحقق من أسعار البيع وسترفض بنود الخصم؛ عطّل الخيار قبل الترحيل."

msgid "{0} must allow negative rates for items (deduction lines post as negative rates)."
msgstr "{0} يجب أن تسمح بأسعار سالبة للأصناف (بنود الخصم تُرحَّل بسعر سالب)."

msgid "{0} must allow the same item on multiple rows (one line per source document)."
msgstr "{0} يجب أن تسمح بتكرار الصنف في أكثر من بند (بند لكل مستند مصدر)."

msgid "Buying Settings requires a Purchase Order; the monthly posting has none."
msgstr "إعدادات الشراء تشترط أمر شراء؛ الترحيل الشهري بلا أوامر شراء."

msgid "Selling Settings requires a {0}; the monthly posting has none."
msgstr "إعدادات البيع تشترط {0}؛ الترحيل الشهري بدونه."

msgid "Item tax template {0} no longer matches the company's VAT accounts; re-run the posting master setup."
msgstr "قالب ضريبة الصنف {0} لم يعد مطابقاً لحسابات الضريبة للشركة؛ أعد تهيئة بيانات الترحيل."

msgid "Item tax template {0} must carry a flat {1}% rate."
msgstr "قالب ضريبة الصنف {0} يجب أن يكون بنسبة ثابتة {1}%."

msgid "Item {0} carries item-level tax templates; CARD items must have none (the line template must win)."
msgstr "الصنف {0} عليه قوالب ضريبة على مستوى الصنف؛ أصناف كارت يجب أن تكون بدونها (قالب البند هو الحاكم)."

