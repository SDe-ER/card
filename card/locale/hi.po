msgstr "मेरे अनुरोध"

msgid "No requests yet."
msgstr "अभी कोई अनुरोध नहीं है।"

msgid "Install the app"
msgstr "ऐप इंस्टॉल करें"

msgid "On iPhone, tap Share, then Add to Home Screen."
msgstr "iPhone पर Share दबाएँ, फिर Add to Home Screen।"

