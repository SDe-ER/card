#. Label of a Desktop Icon
#: card/desktop_icon/card.json
msgid "Card"
msgstr "CARD"

msgid "Load volume (m³)"
msgstr "சரக்கு அளவு (m³)"

msgid "Load volume (m³) is required for the per-m³ customer rate"
msgstr "வாடிக்கையாளர் m³ கட்டணத்திற்கு சரக்கு அளவு (m³) தேவை"

msgid "Load volume used (m³)"
msgstr "பயன்படுத்திய சரக்கு அளவு (m³)"

msgid "Total loads"
msgstr "மொத்த சரக்கு பயணங்கள்"

msgid "Total volume (m³)"
msgstr "மொத்த அளவு (m³)"

msgid "Loads"
msgstr "சரக்கு பயணங்கள்"

msgid "Negative loads on day {0}"
msgstr "{0} ஆம் நாளில் எதிர்மறை பயணங்கள்"

msgid "Loads can be recorded only on a working day: {0}"
msgstr "வேலை நாளில் மட்டுமே பயணங்களைப் பதிவு செய்ய முடியும்: {0}"

msgid "Cannot record loads for a future day: {0}"
msgstr "எதிர்கால நாளுக்கு பயணங்களைப் பதிவு செய்ய முடியாது: {0}"

msgid "بالمتر المكعب"
msgstr "m³ க்கு"

msgid "Loads last month"
msgstr "கடந்த மாத பயணங்கள்"

msgid "Volume last month (m³)"
msgstr "கடந்த மாத அளவு (m³)"

msgid "Loads can be recorded only on a card whose customer rate type is per m³"
msgstr "வாடிக்கையாளர் கட்டண வகை m³ க்கு என உள்ள அட்டையில் மட்டுமே பயணங்களைப் பதிவு செய்ய முடியும்"
