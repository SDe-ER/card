msgstr "Delvist afstemt"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Fully reconciled"
msgstr "Fuldt afstemt"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Approve this cash payment? The approver must not be the requester."
msgstr "Godkend denne kontantbetaling? Godkenderen må ikke være den, der har anmodet."

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Queue for posting"
msgstr "Sæt i kø til bogføring"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Retry posting"
msgstr "Prøv bogføring igen"

