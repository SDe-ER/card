#: card/cash_disbursement.py
msgid "A cash payment is already requested for row {0} of card {1}."
msgstr "Det er allerede bedt om en kontantbetaling for linje {0} på kort {1}."

#: card/cash_disbursement.py
msgid "A cash payment is requested on a Draft card only."
msgstr "Kontantbetaling kan bare bes om for et kort i kladd."

#: card/cash_disbursement.py
msgid "Give the reason for the cancellation."
msgstr "Oppgi årsaken til kanselleringen."

#: card/cash_disbursement.py
msgid "Only a cancelled cash payment can be replaced; {0} is {1}."
msgstr "Bare en kansellert kontantbetaling kan erstattes; {0} er {1}."

#: card/cash_disbursement.py
msgid "Only a Card Manager can approve a cash payment."
msgstr "Bare en kortansvarlig kan godkjenne en kontantbetaling."

#: card/cash_disbursement.py
msgid "Only a Card Manager can post a cash payment."
msgstr "Bare en kortansvarlig kan bokføre en kontantbetaling."

#: card/cash_disbursement.py
msgid "Only a Card Manager can request a cancellation."
msgstr "Bare en kortansvarlig kan be om kansellering."

#: card/cash_disbursement.py
msgid "Only a Card Manager can request a replacement."
msgstr "Bare en kortansvarlig kan be om erstatning."

#: card/cash_disbursement.py
msgid "Only a Pending cash payment can be approved; {0} is {1}."
msgstr "Bare en ventende kontantbetaling kan godkjennes; {0} er {1}."

#: card/cash_disbursement.py
msgid "Only a posted cash payment can be cancelled; {0} is {1}."
msgstr "Bare en bokført kontantbetaling kan kanselleres; {0} er {1}."

#: card/cash_disbursement.py
msgid "Only a queued cash payment can be executed; {0} is {1}."
msgstr "Bare en kontantbetaling i køen kan utføres; {0} er {1}."

#: card/cash_disbursement.py
msgid "Only an approved cash payment can be queued for posting; {0} is {1}."
msgstr "Bare en godkjent kontantbetaling kan settes i kø for bokføring; {0} er {1}."

#: card/cash_disbursement.py
msgid "Row {0} of card {1} already has a live cash payment ({2})."
msgstr "Linje {0} på kort {1} har allerede en aktiv kontantbetaling ({2})."

#: card/cash_disbursement.py
msgid "The cash payment {0} does not exist."
msgstr "Kontantbetalingen {0} finnes ikke."

#: card/cash_disbursement.py
msgid "The cash payment {0} is {1}; it cannot be deleted. Cancel it instead."
msgstr "Kontantbetalingen {0} er {1}; den kan ikke slettes. Kanseller den i stedet."

#: card/cash_disbursement.py
msgid "The requester cannot approve their own cash payment."
msgstr "Den som ber om betalingen, kan ikke godkjenne sin egen kontantbetaling."

#: card/cash_disbursement.py
msgid "The row {0} is no longer on card {1}."
msgstr "Linje {0} er ikke lenger på kort {1}."

#: card/cash_disbursement.py
msgid "The row {0} is not a cash payment on card {1}."
msgstr "Linje {0} er ikke en kontantbetaling på kort {1}."

#: card/cash_disbursement.py
msgid "The cash payment {0} is approved; {1} cannot be changed. Cancel it and request a replacement."
msgstr "Kontantbetalingen {0} er godkjent; {1} kan ikke endres. Kanseller den og be om erstatning."

#: card/cash_disbursement.py
msgid "Journal entry {0} still has active allocations. Resolve them in ERPNext (unreconcile or unlink) before cancelling it."
msgstr "Journalpost {0} har fortsatt aktive tildelinger. Løs dem i ERPNext (fjern avstemmingen eller koblingen) før den kanselleres."

#: card/cash_disbursement.py
msgid "Journal entry {0} pays cash payment {1}. Request its cancellation with a reason first; the payment is then marked Cancelled."
msgstr "Journalpost {0} betaler kontantbetaling {1}. Be først om kansellering med en begrunnelse; betalingen merkes da som Kansellert."
