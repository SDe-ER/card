#. Label of a Desktop Icon
#: card/desktop_icon/card.json
msgid "Card"
msgstr "CARD"

msgid "Load volume (m³)"
msgstr "បរិមាណផ្ទុក (m³)"

msgid "Load volume (m³) is required for the per-m³ customer rate"
msgstr "ត្រូវការបរិមាណផ្ទុក (m³) សម្រាប់អត្រាអតិថិជនក្នុងមួយ m³"

msgid "Load volume used (m³)"
msgstr "បរិមាណផ្ទុកដែលបានប្រើ (m³)"

msgid "Total loads"
msgstr "ចំនួនផ្ទុកសរុប"

msgid "Total volume (m³)"
msgstr "បរិមាណសរុប (m³)"

msgid "Loads"
msgstr "ចំនួនផ្ទុក"

msgid "Negative loads on day {0}"
msgstr "ចំនួនផ្ទុកអវិជ្ជមាននៅថ្ងៃ {0}"

msgid "Cannot record loads for a future day: {0}"
msgstr "មិនអាចកត់ត្រាចំនួនផ្ទុកសម្រាប់ថ្ងៃអនាគតបានទេ៖ {0}"

msgid "بالمتر المكعب"
msgstr "ក្នុងមួយ m³"

msgid "Loads last month"
msgstr "ចំនួនផ្ទុកខែមុន"

msgid "Loads can be recorded only on a card whose customer rate type is per m³"
msgstr "អាចកត់ត្រាចំនួនផ្ទុកបានតែលើកាតដែលប្រភេទអត្រាអតិថិជនជាក្នុងមួយ m³ ប៉ុណ្ណោះ"

msgid "This card has operating hours but no loads, so the customer amount is zero. Check the loads."
msgstr "កាតនេះមានម៉ោងប្រតិបត្តិការ តែគ្មានចំនួនដឹក ដូច្នេះចំនួនទឹកប្រាក់អតិថិជនគឺសូន្យ។ សូមពិនិត្យចំនួនដឹក។"

msgid "Loads were cleared on these non-working days: {0}"
msgstr "ការផ្ទុកត្រូវបានលុបនៅថ្ងៃមិនមែនជាថ្ងៃធ្វើការទាំងនេះ: {0}"
