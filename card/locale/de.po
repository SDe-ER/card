#: card/cash_disbursement.py
msgid "A cash payment is already requested for row {0} of card {1}."
msgstr "Für Zeile {0} der Karte {1} wurde bereits eine Barzahlung angefordert."

#: card/cash_disbursement.py
msgid "A cash payment is requested on a Draft card only."
msgstr "Eine Barzahlung kann nur für eine Karte im Entwurfsstatus angefordert werden."

#: card/cash_disbursement.py
msgid "Give the reason for the cancellation."
msgstr "Geben Sie den Grund für die Stornierung an."

#: card/cash_disbursement.py
msgid "Only a cancelled cash payment can be replaced; {0} is {1}."
msgstr "Nur eine stornierte Barzahlung kann ersetzt werden; {0} ist {1}."

#: card/cash_disbursement.py
msgid "Only a Card Manager can approve a cash payment."
msgstr "Nur ein Kartenmanager kann eine Barzahlung genehmigen."

#: card/cash_disbursement.py
msgid "Only a Card Manager can post a cash payment."
msgstr "Nur ein Kartenmanager kann eine Barzahlung buchen."

#: card/cash_disbursement.py
msgid "Only a Card Manager can request a cancellation."
msgstr "Nur ein Kartenmanager kann eine Stornierung anfordern."

#: card/cash_disbursement.py
msgid "Only a Card Manager can request a replacement."
msgstr "Nur ein Kartenmanager kann einen Ersatz anfordern."

#: card/cash_disbursement.py
msgid "Only a Pending cash payment can be approved; {0} is {1}."
msgstr "Nur eine ausstehende Barzahlung kann genehmigt werden; {0} ist {1}."

#: card/cash_disbursement.py
msgid "Only a posted cash payment can be cancelled; {0} is {1}."
msgstr "Nur eine gebuchte Barzahlung kann storniert werden; {0} ist {1}."

#: card/cash_disbursement.py
msgid "Only a queued cash payment can be executed; {0} is {1}."
msgstr "Nur eine eingereihte Barzahlung kann ausgeführt werden; {0} ist {1}."

#: card/cash_disbursement.py
msgid "Only an approved cash payment can be queued for posting; {0} is {1}."
msgstr "Nur eine genehmigte Barzahlung kann zur Buchung eingereiht werden; {0} ist {1}."

#: card/cash_disbursement.py
msgid "Row {0} of card {1} already has a live cash payment ({2})."
msgstr "Zeile {0} der Karte {1} hat bereits eine aktive Barzahlung ({2})."

#: card/cash_disbursement.py
msgid "The cash payment {0} does not exist."
msgstr "Die Barzahlung {0} existiert nicht."

#: card/cash_disbursement.py
msgid "The cash payment {0} is {1}; it cannot be deleted. Cancel it instead."
msgstr "Die Barzahlung {0} ist {1}; sie kann nicht gelöscht werden. Stornieren Sie sie stattdessen."

#: card/cash_disbursement.py
msgid "The requester cannot approve their own cash payment."
msgstr "Der Antragsteller kann seine eigene Barzahlung nicht genehmigen."

#: card/cash_disbursement.py
msgid "The row {0} is no longer on card {1}."
msgstr "Zeile {0} ist nicht mehr auf der Karte {1} vorhanden."

#: card/cash_disbursement.py
msgid "The row {0} is not a cash payment on card {1}."
msgstr "Zeile {0} ist auf der Karte {1} keine Barzahlung."

#: card/cash_disbursement.py
msgid "The cash payment {0} is approved; {1} cannot be changed. Cancel it and request a replacement."
msgstr "Die Barzahlung {0} ist genehmigt; {1} kann nicht geändert werden. Stornieren Sie sie und beantragen Sie einen Ersatz."

#: card/cash_disbursement.py
msgid "Journal entry {0} still has active allocations. Resolve them in ERPNext (unreconcile or unlink) before cancelling it."
msgstr "Der Journaleintrag {0} hat noch aktive Zuordnungen. Lösen Sie sie in ERPNext (Zuordnung aufheben oder Verknüpfung entfernen), bevor Sie ihn stornieren."

#: card/cash_disbursement.py
msgid "Journal entry {0} pays cash payment {1}. Request its cancellation with a reason first; the payment is then marked Cancelled."
msgstr "Der Journaleintrag {0} begleicht die Barzahlung {1}. Beantragen Sie zuerst die Stornierung mit einer Begründung; die Zahlung wird dann als Storniert markiert."
