msgstr "المكون {0} هو نفسه وحدة."

msgid "Component {0} belongs to company {1}; the unit belongs to {2}."
msgstr "المكون {0} تابع للشركة {1}؛ والوحدة تابعة للشركة {2}."

msgid "Component {0} already belongs to unit {1}."
msgstr "المكون {0} تابع بالفعل للوحدة {1}."

msgid "A component row cannot be moved to another unit."
msgstr "لا يمكن نقل صف مكون إلى وحدة أخرى."

msgid "To change the component, edit unit {0} itself; a direct row update is not allowed."
msgstr "لتغيير المكون، عدّل الوحدة {0} نفسها؛ التعديل المباشر على الصف غير مسموح."

msgid "To change the equipment, edit transport {0} itself; a direct row write is not allowed."
msgstr "لتغيير المعدات، عدّل نقل المعدات {0} نفسه؛ الكتابة المباشرة على الصف غير مسموحة."

msgid "Location sync after an assignment change: project {0} → {1}; assignment date {2} → {3}"
msgstr "مزامنة الموقع بعد تغيير تعيين: المشروع {0} ← {1}؛ تاريخ التعيين {2} ← {3}"

msgid "Location sync after a transfer: project {0} → {1}; assignment date {2} → {3}"
msgstr "مزامنة الموقع بعد نقل: المشروع {0} ← {1}؛ تاريخ التعيين {2} ← {3}"

msgid "Daily location sync: project {0} → {1}; assignment date {2} → {3}"
msgstr "المزامنة اليومية للموقع: المشروع {0} ← {1}؛ تاريخ التعيين {2} ← {3}"

msgid "Daily equipment location sync"
msgstr "المزامنة اليومية لموقع المعدات"

