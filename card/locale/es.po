#: card/cash_disbursement.py
msgid "A cash payment is already requested for row {0} of card {1}."
msgstr "Ya se solicitó un pago en efectivo para la fila {0} de la tarjeta {1}."

#: card/cash_disbursement.py
msgid "A cash payment is requested on a Draft card only."
msgstr "Solo se puede solicitar un pago en efectivo en una tarjeta en borrador."

#: card/cash_disbursement.py
msgid "Give the reason for the cancellation."
msgstr "Indique el motivo de la anulación."

#: card/cash_disbursement.py
msgid "Only a cancelled cash payment can be replaced; {0} is {1}."
msgstr "Solo se puede reemplazar un pago en efectivo anulado; {0} está en estado {1}."

#: card/cash_disbursement.py
msgid "Only a Card Manager can approve a cash payment."
msgstr "Solo un gestor de tarjetas puede aprobar un pago en efectivo."

#: card/cash_disbursement.py
msgid "Only a Card Manager can post a cash payment."
msgstr "Solo un gestor de tarjetas puede contabilizar un pago en efectivo."

#: card/cash_disbursement.py
msgid "Only a Card Manager can request a cancellation."
msgstr "Solo un gestor de tarjetas puede solicitar una anulación."

#: card/cash_disbursement.py
msgid "Only a Card Manager can request a replacement."
msgstr "Solo un gestor de tarjetas puede solicitar un reemplazo."

#: card/cash_disbursement.py
msgid "Only a Pending cash payment can be approved; {0} is {1}."
msgstr "Solo se puede aprobar un pago en efectivo pendiente; {0} está en estado {1}."

#: card/cash_disbursement.py
msgid "Only a posted cash payment can be cancelled; {0} is {1}."
msgstr "Solo se puede anular un pago en efectivo contabilizado; {0} está en estado {1}."

#: card/cash_disbursement.py
msgid "Only a queued cash payment can be executed; {0} is {1}."
msgstr "Solo se puede ejecutar un pago en efectivo en cola; {0} está en estado {1}."

#: card/cash_disbursement.py
msgid "Only an approved cash payment can be queued for posting; {0} is {1}."
msgstr "Solo se puede poner en cola para contabilizar un pago en efectivo aprobado; {0} está en estado {1}."

#: card/cash_disbursement.py
msgid "Row {0} of card {1} already has a live cash payment ({2})."
msgstr "La fila {0} de la tarjeta {1} ya tiene un pago en efectivo activo ({2})."

#: card/cash_disbursement.py
msgid "The cash payment {0} does not exist."
msgstr "El pago en efectivo {0} no existe."

#: card/cash_disbursement.py
msgid "The cash payment {0} is {1}; it cannot be deleted. Cancel it instead."
msgstr "El pago en efectivo {0} está en estado {1}; no se puede eliminar. Anúlelo en su lugar."

#: card/cash_disbursement.py
msgid "The requester cannot approve their own cash payment."
msgstr "El solicitante no puede aprobar su propio pago en efectivo."

#: card/cash_disbursement.py
msgid "The row {0} is no longer on card {1}."
msgstr "La fila {0} ya no está en la tarjeta {1}."

#: card/cash_disbursement.py
msgid "The row {0} is not a cash payment on card {1}."
msgstr "La fila {0} no es un pago en efectivo de la tarjeta {1}."

#: card/cash_disbursement.py
msgid "The cash payment {0} is approved; {1} cannot be changed. Cancel it and request a replacement."
msgstr "El pago en efectivo {0} está aprobado; {1} no se puede modificar. Anúlelo y solicite un reemplazo."

#: card/cash_disbursement.py
msgid "Journal entry {0} still has active allocations. Resolve them in ERPNext (unreconcile or unlink) before cancelling it."
msgstr "El asiento contable {0} todavía tiene asignaciones activas. Resuélvalas en ERPNext (anular la conciliación o desvincular) antes de anularlo."

#: card/cash_disbursement.py
msgid "Journal entry {0} pays cash payment {1}. Request its cancellation with a reason first; the payment is then marked Cancelled."
msgstr "El asiento contable {0} salda el pago en efectivo {1}. Solicite primero la anulación con un motivo; el pago se marcará entonces como Anulado."

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Pending approval"
msgstr "Pendiente de aprobación"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Queued for posting"
msgstr "En cola para contabilizar"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
