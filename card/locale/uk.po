#: card/cash_disbursement.py
msgid "A cash payment is already requested for row {0} of card {1}."
msgstr "Готівковий платіж для рядка {0} картки {1} вже запитано."

#: card/cash_disbursement.py
msgid "A cash payment is requested on a Draft card only."
msgstr "Готівковий платіж можна запитати лише для картки в статусі чернетки."

#: card/cash_disbursement.py
msgid "Give the reason for the cancellation."
msgstr "Вкажіть причину скасування."

#: card/cash_disbursement.py
msgid "Only a cancelled cash payment can be replaced; {0} is {1}."
msgstr "Замінити можна лише скасований готівковий платіж; {0} має статус {1}."

#: card/cash_disbursement.py
msgid "Only a Card Manager can approve a cash payment."
msgstr "Схвалити готівковий платіж може лише менеджер карток."

#: card/cash_disbursement.py
msgid "Only a Card Manager can post a cash payment."
msgstr "Провести готівковий платіж може лише менеджер карток."

#: card/cash_disbursement.py
msgid "Only a Card Manager can request a cancellation."
msgstr "Запросити скасування може лише менеджер карток."

#: card/cash_disbursement.py
msgid "Only a Card Manager can request a replacement."
msgstr "Запросити заміну може лише менеджер карток."

#: card/cash_disbursement.py
msgid "Only a Pending cash payment can be approved; {0} is {1}."
msgstr "Схвалити можна лише готівковий платіж в очікуванні; {0} має статус {1}."

#: card/cash_disbursement.py
msgid "Only a posted cash payment can be cancelled; {0} is {1}."
msgstr "Скасувати можна лише проведений готівковий платіж; {0} має статус {1}."

#: card/cash_disbursement.py
msgid "Only a queued cash payment can be executed; {0} is {1}."
msgstr "Виконати можна лише готівковий платіж у черзі; {0} має статус {1}."

#: card/cash_disbursement.py
msgid "Only an approved cash payment can be queued for posting; {0} is {1}."
msgstr "До черги на проведення можна додати лише схвалений готівковий платіж; {0} має статус {1}."

#: card/cash_disbursement.py
msgid "Row {0} of card {1} already has a live cash payment ({2})."
msgstr "У рядку {0} картки {1} вже є активний готівковий платіж ({2})."

#: card/cash_disbursement.py
msgid "The cash payment {0} does not exist."
msgstr "Готівковий платіж {0} не існує."

#: card/cash_disbursement.py
msgid "The cash payment {0} is {1}; it cannot be deleted. Cancel it instead."
msgstr "Готівковий платіж {0} має статус {1}; його не можна видалити. Скасуйте його натомість."

#: card/cash_disbursement.py
msgid "The requester cannot approve their own cash payment."
msgstr "Заявник не може схвалити власний готівковий платіж."

#: card/cash_disbursement.py
msgid "The row {0} is no longer on card {1}."
msgstr "Рядка {0} більше немає на картці {1}."

#: card/cash_disbursement.py
msgid "The row {0} is not a cash payment on card {1}."
msgstr "Рядок {0} не є готівковим платежем на картці {1}."

#: card/cash_disbursement.py
msgid "The cash payment {0} is approved; {1} cannot be changed. Cancel it and request a replacement."
msgstr "Готівковий платіж {0} схвалено; {1} змінити не можна. Скасуйте його та запросіть заміну."

#: card/cash_disbursement.py
msgid "Journal entry {0} still has active allocations. Resolve them in ERPNext (unreconcile or unlink) before cancelling it."
msgstr "У проводки журналу {0} ще є активні розподіли. Врегулюйте їх у ERPNext (скасуйте звірку або від'єднайте) перед скасуванням."

#: card/cash_disbursement.py
msgid "Journal entry {0} pays cash payment {1}. Request its cancellation with a reason first; the payment is then marked Cancelled."
msgstr "Проводка журналу {0} погашає готівковий платіж {1}. Спочатку запросіть скасування з причиною; платіж отримає статус «Скасовано»."

