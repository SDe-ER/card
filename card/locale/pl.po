#: card/cash_disbursement.py
msgid "A cash payment is already requested for row {0} of card {1}."
msgstr "Płatność gotówkowa dla wiersza {0} karty {1} została już zgłoszona."

#: card/cash_disbursement.py
msgid "A cash payment is requested on a Draft card only."
msgstr "Płatność gotówkową można zgłosić tylko dla karty w wersji roboczej."

#: card/cash_disbursement.py
msgid "Give the reason for the cancellation."
msgstr "Podaj powód anulowania."

#: card/cash_disbursement.py
msgid "Only a cancelled cash payment can be replaced; {0} is {1}."
msgstr "Zastąpić można tylko anulowaną płatność gotówkową; {0} ma status {1}."

#: card/cash_disbursement.py
msgid "Only a Card Manager can approve a cash payment."
msgstr "Płatność gotówkową może zatwierdzić tylko kierownik kart."

#: card/cash_disbursement.py
msgid "Only a Card Manager can post a cash payment."
msgstr "Płatność gotówkową może zaksięgować tylko kierownik kart."

#: card/cash_disbursement.py
msgid "Only a Card Manager can request a cancellation."
msgstr "Anulowanie może zgłosić tylko kierownik kart."

#: card/cash_disbursement.py
msgid "Only a Card Manager can request a replacement."
msgstr "Zastąpienie może zgłosić tylko kierownik kart."

#: card/cash_disbursement.py
msgid "Only a Pending cash payment can be approved; {0} is {1}."
msgstr "Zatwierdzić można tylko oczekującą płatność gotówkową; {0} ma status {1}."

#: card/cash_disbursement.py
msgid "Only a posted cash payment can be cancelled; {0} is {1}."
msgstr "Anulować można tylko zaksięgowaną płatność gotówkową; {0} ma status {1}."

#: card/cash_disbursement.py
msgid "Only a queued cash payment can be executed; {0} is {1}."
msgstr "Wykonać można tylko płatność gotówkową w kolejce; {0} ma status {1}."

#: card/cash_disbursement.py
msgid "Only an approved cash payment can be queued for posting; {0} is {1}."
msgstr "Do kolejki księgowania można dodać tylko zatwierdzoną płatność gotówkową; {0} ma status {1}."

#: card/cash_disbursement.py
msgid "Row {0} of card {1} already has a live cash payment ({2})."
msgstr "Wiersz {0} karty {1} ma już aktywną płatność gotówkową ({2})."

#: card/cash_disbursement.py
msgid "The cash payment {0} does not exist."
msgstr "Płatność gotówkowa {0} nie istnieje."

#: card/cash_disbursement.py
msgid "The cash payment {0} is {1}; it cannot be deleted. Cancel it instead."
msgstr "Płatność gotówkowa {0} ma status {1}; nie można jej usunąć. Anuluj ją zamiast tego."

#: card/cash_disbursement.py
msgid "The requester cannot approve their own cash payment."
msgstr "Wnioskodawca nie może zatwierdzić własnej płatności gotówkowej."

#: card/cash_disbursement.py
msgid "The row {0} is no longer on card {1}."
msgstr "Wiersz {0} nie znajduje się już na karcie {1}."

#: card/cash_disbursement.py
msgid "The row {0} is not a cash payment on card {1}."
msgstr "Wiersz {0} nie jest płatnością gotówkową na karcie {1}."

#: card/cash_disbursement.py
msgid "The cash payment {0} is approved; {1} cannot be changed. Cancel it and request a replacement."
msgstr "Płatność gotówkowa {0} jest zatwierdzona; {1} nie może zostać zmienione. Anuluj ją i zgłoś zastąpienie."

#: card/cash_disbursement.py
msgid "Journal entry {0} still has active allocations. Resolve them in ERPNext (unreconcile or unlink) before cancelling it."
msgstr "Zapis księgowy {0} ma nadal aktywne alokacje. Rozlicz je w ERPNext (cofnij uzgodnienie lub odłącz) przed anulowaniem."

#: card/cash_disbursement.py
msgid "Journal entry {0} pays cash payment {1}. Request its cancellation with a reason first; the payment is then marked Cancelled."
msgstr "Zapis księgowy {0} rozlicza płatność gotówkową {1}. Najpierw zgłoś anulowanie z podaniem powodu; płatność otrzyma wtedy status Anulowano."

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Pending approval"
msgstr "Oczekuje na zatwierdzenie"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Queued for posting"
msgstr "W kolejce do zaksięgowania"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Posting failed"
msgstr "Księgowanie nie powiodło się"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Cancellation requested"
msgstr "Zgłoszono anulowanie"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
msgid "Not reconciled"
msgstr "Nieuzgodnione"

#: card/card/doctype/card_cash_disbursement/card_cash_disbursement.js
