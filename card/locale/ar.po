msgstr "نوع الإضافة/الخصم {0} على الكارت {1} غير مُعد (أو معطّل) في إعدادات كارت."

msgid "{0} no longer matches its source documents (lines total {1}, sources total {2}); rebuild the posting instead of editing it."
msgstr "{0} لم تعد مطابقة لمستنداتها المصدر (إجمالي البنود {1} وإجمالي المصادر {2})؛ أعد بناء الترحيل بدلاً من تعديله."

msgid "Source {0} {1} is now included in another active posting unit ({2}); rebuild before submitting {3}."
msgstr "المستند المصدر {0} {1} أصبح مُدرجاً في وحدة ترحيل نشطة أخرى ({2})؛ أعد البناء قبل اعتماد {3}."

msgid "Posting log {0} is the audit record of a CARD posting and cannot be deleted."
msgstr "سجل الترحيل {0} هو سجل التدقيق لترحيل من CARD ولا يمكن حذفه."

msgid "Posting log {0} is an audit record and cannot be edited."
msgstr "سجل الترحيل {0} سجل تدقيق ولا يمكن تعديله."

