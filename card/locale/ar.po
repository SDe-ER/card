msgstr "توجد مسودة ترحيل بالفعل لـ{0} {1} في {2}/{3}: ‏{4}. اعتمدها، أو أعد بناءها لتشمل المستندات الأحدث."

msgid "Nothing to post: no unposted submitted documents for {0} {1} in {2}/{3}."
msgstr "لا شيء للترحيل: لا مستندات معتمدة غير مرحّلة لـ{0} {1} في {2}/{3}."

msgid "Configure Card Settings for company {0}: Sales tax template is not set."
msgstr "قم بإعداد إعدادات كارت للشركة {0}: قالب ضريبة المبيعات غير محدد."

msgid "The monthly total for {0} {1} is negative ({2}); deductions exceed the dues. Resolve the cards ({3}) or ask the owner how to carry the balance."
msgstr "الإجمالي الشهري لـ{0} {1} سالب ({2})؛ الخصومات تتجاوز المستحق. عالج الكروت ({3}) أو راجع المالك في طريقة ترحيل الرصيد."

msgid "Only Card Manager or System Manager may build monthly postings."
msgstr "إنشاء الترحيلات الشهرية متاح فقط لمدير كارت أو مدير النظام."

msgid "Party type must be Supplier or Customer."
msgstr "نوع الطرف يجب أن يكون مورداً أو عميلاً."

msgid "{0} was generated by CARD; apply discounts as addition/deduction rows on the cards, not on the invoice."
msgstr "{0} أنشأه تطبيق كارت؛ طبّق الخصومات كبنود إضافة/خصم على الكروت لا على الفاتورة."

msgid "Posting document deleted; sources freed."
msgstr "تم حذف مستند الترحيل؛ تم تحرير المستندات المصدر."

msgid "{0} is included in submitted posting {1}; cancel that invoice first."
msgstr "{0} مُدرج في الترحيل المعتمد {1}؛ ألغِ تلك الفاتورة أولاً."

msgid "{0} is reserved by draft posting {1}; delete or rebuild that invoice first."
msgstr "{0} محجوز بمسودة الترحيل {1}؛ احذف تلك الفاتورة أو أعد بناءها أولاً."

msgid "{0} amends CARD posting {1}; amendments would post the same source documents twice. Build the month again from CARD instead."
msgstr "{0} يعدّل ترحيل كارت {1}؛ التعديل سيرحّل نفس المستندات المصدر مرتين. أعد بناء الشهر من كارت بدلاً من ذلك."

msgid "This invoice"
msgstr "هذه الفاتورة"

msgid "Enter the supplier's invoice number and date (Bill No / Bill Date) on {0} before submitting; VAT input requires them."
msgstr "أدخل رقم فاتورة المورد وتاريخها (رقم الفاتورة / تاريخ الفاتورة) على {0} قبل الاعتماد؛ ضريبة المدخلات تتطلبهما."

msgid "Source {0} {1} is no longer submitted; rebuild the posting before submitting {2}."
msgstr "المستند المصدر {0} {1} لم يعد معتمداً؛ أعد بناء الترحيل قبل اعتماد {2}."

msgid "Source {0} {1} is already invoiced by {2}; rebuild the posting before submitting {3}."
msgstr "المستند المصدر {0} {1} مفوتر بالفعل في {2}؛ أعد بناء الترحيل قبل اعتماد {3}."

msgid "Supplier {0} is VAT-registered (tax ID set) but Card Settings for company {1} has no Purchase tax template; posting would silently drop the VAT."
msgstr "المورد {0} مسجّل في ضريبة القيمة المضافة (الرقم الضريبي محدد) لكن إعدادات كارت للشركة {1} بلا قالب ضريبة مشتريات؛ الترحيل سيُسقط الضريبة بصمت."

msgid "Customer {0} has both a zero-rated addition line and a deduction discount in {1}/{2}; the discount would shift the VAT base across the zero-rated line. Post them in separate months or ask the owner."
msgstr "العميل {0} لديه بند إضافة بنسبة صفرية وخصم استقطاع معاً في {1}/{2}؛ الخصم سيحرّف وعاء الضريبة عبر البند الصفري. رحّلهما في شهرين منفصلين أو راجع المالك."

msgid "Non-taxable customer-side deduction {0} on card {1} is not supported on a Sales Invoice (ZATCA: no negative lines; a Net Total discount would change the VAT base). Ask the owner for the representation."
msgstr "خصم جهة العميل غير الخاضع للضريبة {0} على الكارت {1} غير مدعوم في فاتورة مبيعات (زاتكا: لا بنود سالبة؛ وخصم صافي الإجمالي سيغيّر وعاء الضريبة). راجع المالك لتحديد طريقة التمثيل."

msgid "Month and year must be numbers."
msgstr "الشهر والسنة يجب أن يكونا رقمين."

msgid "Month must be between 1 and 12."
msgstr "الشهر يجب أن يكون بين 1 و12."

msgid "Accounts Settings option {0} must be off: it would copy extra tax rows onto the generated postings."
msgstr "خيار إعدادات الحسابات {0} يجب أن يكون مُعطّلاً: سينسخ صفوف ضرائب إضافية على الترحيلات المُنشأة."

msgid "Invalid side {0} on addition/deduction {1}; it must be Supplier or Customer."
msgstr "جهة غير صالحة {0} في الإضافة/الخصم {1}؛ يجب أن تكون مورداً أو عميلاً."

msgid "Addition/deduction type {0} on card {1} is not configured (or is disabled) in Card Settings."
msgstr "نوع الإضافة/الخصم {0} على الكارت {1} غير مُعد (أو معطّل) في إعدادات كارت."

msgid "{0} no longer matches its source documents (lines total {1}, sources total {2}); rebuild the posting instead of editing it."
msgstr "{0} لم تعد مطابقة لمستنداتها المصدر (إجمالي البنود {1} وإجمالي المصادر {2})؛ أعد بناء الترحيل بدلاً من تعديله."

msgid "Source {0} {1} is now included in another active posting unit ({2}); rebuild before submitting {3}."
msgstr "المستند المصدر {0} {1} أصبح مُدرجاً في وحدة ترحيل نشطة أخرى ({2})؛ أعد البناء قبل اعتماد {3}."

msgid "Posting log {0} is the audit record of a CARD posting and cannot be deleted."
msgstr "سجل الترحيل {0} هو سجل التدقيق لترحيل من CARD ولا يمكن حذفه."

msgid "Posting log {0} is an audit record and cannot be edited."
msgstr "سجل الترحيل {0} سجل تدقيق ولا يمكن تعديله."

msgid "Posting logs are created only by CARD's monthly posting."
msgstr "سجلات الترحيل تُنشأ فقط من خلال الترحيل الشهري في CARD."

msgid "The sources of a posting log cannot be changed."
msgstr "لا يمكن تغيير مصادر سجل الترحيل."

msgid "Change tracking cannot be turned on for {0}: its earlier history holds figures of every company."
msgstr "لا يمكن تفعيل تتبع التغييرات على {0}: سجله السابق يحتوي على أرقام كل الشركات."

msgid "Tax template {0} must contain only 'On Net Total' rows with non-negative rates; found a '{1}' row. Fix the template before posting."
msgstr "قالب الضريبة {0} يجب أن يحتوي على صفوف من نوع 'On Net Total' فقط بنسب غير سالبة؛ وُجد صف من نوع '{1}'. صحّح القالب قبل الترحيل."

msgid "Tax template {0}: a VAT row has no account head."
msgstr "قالب الضريبة {0}: أحد صفوف الضريبة بلا حساب."

msgid "Tax template {0} carries multiple VAT rows; posting through multi-rate templates is not supported yet (the per-line overrides are single-rate) — configure a single-rate template for posting."
msgstr "قالب الضريبة {0} يحتوي على عدة صفوف ضريبة؛ الترحيل عبر قوالب متعددة النسب غير مدعوم بعد (التجاوزات الصفّية أحادية النسبة) — استخدم قالباً أحادي النسبة للترحيل."

msgid "{0} was retargeted to another company; rebuild the posting instead of editing it."
msgstr "{0} أُعيد توجيهها لشركة أخرى؛ أعد بناء الترحيل بدلاً من تعديله."

msgid "{0} is dated {1}, outside its posting unit's month {2}/{3}; keep the posting date inside the unit's month."
msgstr "{0} مؤرخة في {1} خارج شهر وحدة الترحيل {2}/{3}؛ أبقِ تاريخ الترحيل داخل شهر الوحدة."

msgid "This equipment is a unit component; the monthly card is kept on the unit, not the component."
msgstr "هذه المعدة مكوّن ضمن وحدة؛ الكارت الشهري يُسجّل على الوحدة لا على المكوّن."

msgid "The Card Equipment accounting dimension is missing or disabled on this site; an administrator must run: bench --site <site> execute card.dimension.ensure_card_equipment_dimension"
msgstr "البُعد المحاسبي «معدة كارت» غير موجود أو معطّل على هذا الموقع؛ يجب أن ينفّذ مدير النظام: bench --site <site> execute card.dimension.ensure_card_equipment_dimension"

msgid "The {0} field is missing on {1}; re-run the Card Equipment dimension setup before posting."
msgstr "الحقل {0} غير موجود على {1}؛ أعد تنفيذ إعداد بُعد معدة كارت قبل الترحيل."

msgid "Ledger balances are shown only to users with General Ledger access."
msgstr "أرصدة دفتر الأستاذ تظهر فقط للمستخدمين الذين لديهم صلاحية الاطلاع على دفتر الأستاذ العام."

msgid "You are not permitted to view data of company {0}"
msgstr "غير مسموح لك بالاطلاع على بيانات الشركة {0}"

msgid "This report requires General Ledger access."
msgstr "هذا التقرير يتطلب صلاحية الاطلاع على دفتر الأستاذ العام."

msgid "Equipment supplier statement: {0} — Period from {1} to {2} — Issue date {3}."
msgstr "كشف حساب مورد معدات: {0} — الفترة من {1} إلى {2} — تاريخ الإصدار {3}."

msgid "Equipment customer statement: {0} — Period from {1} to {2} — Issue date {3}."
msgstr "كشف حساب عميل معدات: {0} — الفترة من {1} إلى {2} — تاريخ الإصدار {3}."

msgid "Party type"
msgstr "نوع الطرف"

msgid "Posting type"
msgstr "نوع الترحيل"

msgid "Posting key"
msgstr "مفتاح الترحيل"

msgid "Posting DocType"
msgstr "نوع مستند الترحيل"

