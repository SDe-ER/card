msgstr "تعبئة ديزل {0} — {1} لتر حصة تقديرية من {2} لتر (توزيع بالساعات)"

msgid "Invoiced through Card (net before VAT)"
msgstr "مفوتر عبر Card (الصافي قبل الضريبة)"

msgid "ERPNext invoices outside Card — to reconcile (net before VAT)"
msgstr "فواتير ERPNext خارج Card — تحتاج مطابقة (الصافي قبل الضريبة)"

