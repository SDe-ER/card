#: card/cash_disbursement.py
msgid "A cash payment is already requested for row {0} of card {1}."
msgstr "Наличный платёж для строки {0} карты {1} уже запрошен."

#: card/cash_disbursement.py
msgid "A cash payment is requested on a Draft card only."
msgstr "Наличный платёж можно запросить только для карты в статусе черновика."

#: card/cash_disbursement.py
msgid "Give the reason for the cancellation."
msgstr "Укажите причину отмены."

#: card/cash_disbursement.py
msgid "Only a cancelled cash payment can be replaced; {0} is {1}."
msgstr "Заменить можно только отменённый наличный платёж; {0} имеет статус {1}."

#: card/cash_disbursement.py
msgid "Only a Card Manager can approve a cash payment."
msgstr "Утвердить наличный платёж может только менеджер карт."

#: card/cash_disbursement.py
msgid "Only a Card Manager can post a cash payment."
msgstr "Провести наличный платёж может только менеджер карт."

#: card/cash_disbursement.py
msgid "Only a Card Manager can request a cancellation."
msgstr "Запросить отмену может только менеджер карт."

#: card/cash_disbursement.py
msgid "Only a Card Manager can request a replacement."
msgstr "Запросить замену может только менеджер карт."

#: card/cash_disbursement.py
msgid "Only a Pending cash payment can be approved; {0} is {1}."
msgstr "Утвердить можно только ожидающий наличный платёж; {0} имеет статус {1}."

#: card/cash_disbursement.py
msgid "Only a posted cash payment can be cancelled; {0} is {1}."
msgstr "Отменить можно только проведённый наличный платёж; {0} имеет статус {1}."

#: card/cash_disbursement.py
msgid "Only a queued cash payment can be executed; {0} is {1}."
msgstr "Выполнить можно только наличный платёж в очереди; {0} имеет статус {1}."

#: card/cash_disbursement.py
msgid "Only an approved cash payment can be queued for posting; {0} is {1}."
msgstr "В очередь на проведение можно поставить только утверждённый наличный платёж; {0} имеет статус {1}."

#: card/cash_disbursement.py
msgid "Row {0} of card {1} already has a live cash payment ({2})."
msgstr "В строке {0} карты {1} уже есть активный наличный платёж ({2})."

#: card/cash_disbursement.py
msgid "The cash payment {0} does not exist."
msgstr "Наличный платёж {0} не существует."

#: card/cash_disbursement.py
msgid "The cash payment {0} is {1}; it cannot be deleted. Cancel it instead."
msgstr "Наличный платёж {0} имеет статус {1}; его нельзя удалить. Отмените его."

#: card/cash_disbursement.py
msgid "The requester cannot approve their own cash payment."
msgstr "Заявитель не может утвердить собственный наличный платёж."

#: card/cash_disbursement.py
msgid "The row {0} is no longer on card {1}."
msgstr "Строки {0} больше нет на карте {1}."

#: card/cash_disbursement.py
msgid "The row {0} is not a cash payment on card {1}."
msgstr "Строка {0} не является наличным платежом на карте {1}."

#: card/cash_disbursement.py
msgid "The cash payment {0} is approved; {1} cannot be changed. Cancel it and request a replacement."
msgstr "Наличный платёж {0} утверждён; {1} изменить нельзя. Отмените его и запросите замену."

#: card/cash_disbursement.py
msgid "Journal entry {0} still has active allocations. Resolve them in ERPNext (unreconcile or unlink) before cancelling it."
msgstr "У проводки журнала {0} всё ещё есть активные распределения. Урегулируйте их в ERPNext (отмените сверку или отвяжите) перед отменой."

#: card/cash_disbursement.py
msgid "Journal entry {0} pays cash payment {1}. Request its cancellation with a reason first; the payment is then marked Cancelled."
msgstr "Проводка журнала {0} погашает наличный платёж {1}. Сначала запросите отмену с указанием причины; после этого платёж получит статус «Отменён»."

