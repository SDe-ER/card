#. Label of a Desktop Icon
#: card/desktop_icon/card.json
msgid "Card"
msgstr "CARD"

msgid "Load volume (m³)"
msgstr "حجم بار (m³)"

msgid "Load volume (m³) is required for the per-m³ customer rate"
msgstr "حجم بار (m³) برای نرخ مشتری به ازای هر متر مکعب الزامی است"

msgid "Load volume used (m³)"
msgstr "حجم بار مورد استفاده (m³)"

msgid "Total loads"
msgstr "مجموع بارها"

msgid "Total volume (m³)"
msgstr "حجم کل (m³)"

msgid "Loads"
msgstr "بارها"

msgid "Negative loads on day {0}"
msgstr "بارهای منفی در روز {0}"

msgid "Cannot record loads for a future day: {0}"
msgstr "ثبت بار برای روز آینده امکان‌پذیر نیست: {0}"

msgid "بالمتر المكعب"
msgstr "به ازای هر متر مکعب"

msgid "Loads last month"
msgstr "بارهای ماه گذشته"

msgid "Loads can be recorded only on a card whose customer rate type is per m³"
msgstr "ثبت بار فقط در کارتی امکان‌پذیر است که نوع نرخ مشتری آن به ازای هر متر مکعب باشد"

msgid "This card has operating hours but no loads, so the customer amount is zero. Check the loads."
msgstr "این کارت ساعت کاری دارد اما بار ندارد، بنابراین مبلغ مشتری صفر است. بارها را بررسی کنید."

msgid "Loads were cleared on these non-working days: {0}"
msgstr "بارها در این روزهای غیرکاری پاک شدند: {0}"

msgid "Check the loads"
msgstr "بارها را بررسی کنید"
